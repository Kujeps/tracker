# Скопируй в .env и заполни. Файл .env в .gitignore — не коммитить.
# Всё, что не начинается с SUPABASE_, загружается в секреты функций (см. README).

# Токен от @BotFather
TELEGRAM_BOT_TOKEN=
# Случайная строка: символы A-Z, a-z, 0-9, _ и -, до 256 символов (например, openssl rand -hex 32)
TELEGRAM_WEBHOOK_SECRET=

# Адрес проекта: https://<project-ref>.supabase.co
SUPABASE_URL=
# Project Settings → API Keys → service_role. В облачных функциях доступен автоматически
SUPABASE_SERVICE_ROLE_KEY=

# Секрет, с которым pg_cron вызывает dispatch-reminders (Этап 2)
CRON_SECRET=

# Нейросеть (Этап 1)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=
LLM_MODEL=google/gemma-4-26b-a4b-it:free
# Платная версия той же модели: работает только при положительном балансе OpenRouter
LLM_FALLBACK_MODEL=google/gemma-4-26b-a4b-it
# Потолок вызовов нейросети в сутки на весь сервис
LLM_DAILY_CAP=50

# Распознавание речи (Этап 5)
STT_PROVIDER=
STT_API_KEY=

# Адрес Mini App (Этап 4)
MINIAPP_URL=

# Тарифы (Этап 6)
FREE_AI_ENTRIES_PER_MONTH=
PRO_PRICE_STARS=

# Через запятую. Свой telegram_id можно узнать у @userinfobot
ADMIN_TELEGRAM_IDS=

# Только для Supabase CLI на машине разработчика, в секреты функций не загружаются.
# Токен доступа: supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
# Пароль базы: Project Settings → Database
SUPABASE_DB_PASSWORD=
# Строка подключения через pooler (session mode, порт 5432):
# postgresql://postgres.<project-ref>:<пароль>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
