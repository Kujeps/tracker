{
  "imports": {
    "grammy": "npm:grammy@1.46.0",
    "grammy/types": "npm:grammy@1.46.0/types",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2.118.0",
    "@std/assert": "jsr:@std/assert@1.0.19"
  },
  "compilerOptions": {
    "strict": true
  },
  "tasks": {
    "lint": "deno lint",
    "check": "deno check supabase/functions scripts",
    "test": "deno test --allow-env supabase/functions",
    "set-webhook": "deno run --env-file=.env --allow-env --allow-net=api.telegram.org scripts/set-webhook.ts"
  },
  "lint": {
    "include": ["supabase/functions", "scripts"]
  },
  "fmt": {
    "include": ["supabase/functions", "scripts"]
  }
}
